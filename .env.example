# Local CDP only
ENGINE_BACKEND=local
HOST=0.0.0.0
PORT=8090
PUBLIC_BASE=http://127.0.0.1:8090
TZ=Asia/Shanghai
DATABASE_URL=sqlite:///./data/muse-proxy.db
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-session-secret

# Upstream muse2api (aliases: UPSTREAM_BASE)
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=

# Outbound keys for clients calling this proxy (comma-separated also OK)
MUSE_PROXY_KEY=mprox_dev_replace_me
PROXY_API_KEYS=

CONNECT_TIMEOUT_SEC=10
REQUEST_TIMEOUT_SEC=600
STREAM_IDLE_TIMEOUT_SEC=120
MAX_CONCURRENCY=8
MEDIA_AUTH_REQUIRED=true
REWRITE_MEDIA_URLS=true
CONSOLE_GENERATE_ENABLED=true
# Alias: GENERATE_PLAYGROUND=1
GENERATE_PLAYGROUND=1
CONSOLE_TOKEN_TTL_SEC=900
RECORD_KEEP_DAYS=30
CHARGE_ON_UPSTREAM_ERROR=false
SIGNUP_CREDENTIALS_KEY=
SIGNUP_WEBHOOK_TOKEN=
SIGNUP_CLIENT=http
SIGNUP_MUSE_BASE=https://muse.ai
# --- 卡池 / $1 年龄验证 checkout ---
CHECKOUT_ENABLED=true
CHECKOUT_AMOUNT=1.00
CHECKOUT_CURRENCY=USD
CHECKOUT_PRODUCT_ID=766358168544755
CHECKOUT_RECEIVER_ID=352501280694489
CHECKOUT_MAX_CARD_TRIES=3
CHECKOUT_PTT_MODE=jwe
# 真实浏览器 TLS 指纹（curl_cffi）；off 则用 httpx
SIGNUP_TLS_IMPERSONATE=chrome
SIGNUP_AUTO_PASSWORD=true
SIGNUP_MAIL_WAIT_SEC=90
SIGNUP_MAIL_POLL_SEC=5
PROXY_SCHEDULED_KEEPALIVE=false
TOKEN_PREFIX=mprox_
